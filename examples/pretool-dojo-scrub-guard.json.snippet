{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dev/hooks/scripts/pretool-dojo-scrub-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
