{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__ship__get_workflow_run",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dev/hooks/scripts/posttool-ship-getrun.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
