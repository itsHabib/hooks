{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__ship__ship",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dev/hooks/scripts/posttool-ship-ship-dispatch.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
