#!/usr/bin/env bash
set -euo pipefail

log="${HOOK_TEST_TMP:?}/gh.log"
mkdir -p "$(dirname "$log")"
printf '%s\n' "$*" >>"$log"

case "$*" in
  *"pr view 101"*"state,mergeCommit"*)
    printf '{"state":"MERGED","mergeCommit":{"oid":"abc123def4567890abcdef1234567890abcdef12"}}'
    ;;
  *"pr view 102"*"state,mergeCommit"*)
    printf '{"state":"OPEN","mergeCommit":null}'
    ;;
  *"pr view 103"*"state,mergeCommit"*)
    printf '{"state":"CLOSED","mergeCommit":null}'
    ;;
  *)
    echo "unexpected gh invocation: $*" >&2
    exit 1
    ;;
esac
