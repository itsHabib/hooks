#!/usr/bin/env bash
set -euo pipefail

log="${HOOK_TEST_TMP:?}/gh.log"
mkdir -p "$(dirname "$log")"
printf '%s\n' "$*" >>"$log"

case "$*" in
  *"pr view 42"*"mergeCommit"*)
    printf '%s' "abc123def4567890abcdef1234567890abcdef12"
    ;;
  *"pr view 42"*"body"*)
    printf '%s' $'Summary\n\nCloses task/gh-pr-merge-hook\n'
    ;;
  *"pr view 99"*"mergeCommit"*)
    printf '%s' "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
    ;;
  *"pr view 99"*"body"*)
    printf '%s' $'Summary without task linkage\n'
    ;;
  *"pr view 7"*"body"*)
    printf '%s' $'## Summary\n\nCloses task/gh-pr-create-hook\n'
    ;;
  *"pr view 7"*"title"*)
    printf '%s' "Add gh pr create hook"
    ;;
  *"pr view 8"*"body"*)
    printf '%s' $'Summary without task linkage\n'
    ;;
  *"pr view 8"*"title"*)
    printf '%s' "Docs only"
    ;;
  *"pr view 9"*"body"*)
    printf '%s' "Closes task/"
    ;;
  *"pr view 9"*"title"*)
    printf '%s' "Malformed linkage"
    ;;
  *)
    echo "unexpected gh invocation: $*" >&2
    exit 1
    ;;
esac
