#!/usr/bin/env bash
set -euo pipefail

log="${HOOK_TEST_TMP:?}/gh.log"
mkdir -p "$(dirname "$log")"
printf '%s\n' "$*" >>"$log"

case "$*" in
  *"pr view 42"*"mergeCommit"*)
    printf '%s' "abc123def4567890abcdef1234567890abcdef12"
    ;;
  *"pr view 42"*"body"*)
    printf '%s' $'Summary\n\nCloses task/gh-pr-merge-hook\n'
    ;;
  # PR 43 (linked task via backtick form)
  *"pr view 43"*"mergeCommit"*)
    printf '%s' "feedfacefeedfacefeedfacefeedfacefeedface"
    ;;
  *"pr view 43"*"body"*)
    printf '%s' $'Summary\n\nCloses task `gh-pr-merge-hook`\n'
    ;;
  *"pr view 99"*"mergeCommit"*)
    printf '%s' "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
    ;;
  *"pr view 99"*"body"*)
    printf '%s' $'Summary without task linkage\n'
    ;;
  # PR 7 (linked task) — accept both "pr view 7" and URL form
  *"pr view 7"*"body"* | *"pr view "*"pull/7"*"body"*)
    printf '%s' $'## Summary\n\nCloses task/gh-pr-create-hook\n'
    ;;
  *"pr view 7"*"title"* | *"pr view "*"pull/7"*"title"*)
    printf '%s' "Add gh pr create hook"
    ;;
  # PR 8 (no linkage)
  *"pr view 8"*"body"* | *"pr view "*"pull/8"*"body"*)
    printf '%s' $'Summary without task linkage\n'
    ;;
  *"pr view 8"*"title"* | *"pr view "*"pull/8"*"title"*)
    printf '%s' "Docs only"
    ;;
  # PR 9 (malformed linkage)
  *"pr view 9"*"body"* | *"pr view "*"pull/9"*"body"*)
    printf '%s' "Closes task/"
    ;;
  *"pr view 9"*"title"* | *"pr view "*"pull/9"*"title"*)
    printf '%s' "Malformed linkage"
    ;;
  # PR 11 (linked task via backtick form)
  *"pr view 11"*"body"* | *"pr view "*"pull/11"*"body"*)
    printf '%s' $'## Summary\n\nCloses task `gh-pr-create-hook`\n'
    ;;
  *"pr view 11"*"title"* | *"pr view "*"pull/11"*"title"*)
    printf '%s' "Add gh pr create hook"
    ;;
  *)
    echo "unexpected gh invocation: $*" >&2
    exit 1
    ;;
esac
