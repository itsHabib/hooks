#!/usr/bin/env bash
set -euo pipefail

log="${HOOK_TEST_TMP:?}/dossier.log"
state_dir="${HOOK_TEST_TMP}/dossier-state"
mkdir -p "$(dirname "$log")" "$state_dir"
printf '%s\n' "$*" >>"$log"

_state_key() {
  printf '%s' "$*" | cksum | awk '{print $1}'
}

_record_call() {
  local verb="$1"
  local key
  key="$(_state_key "$*")"
  if [[ -f "$state_dir/${verb}.${key}" ]]; then
    printf '%s NOOP\n' "$verb" >>"$log"
    return 0
  fi
  touch "$state_dir/${verb}.${key}"
  printf '%s NEW\n' "$verb" >>"$log"
}

case "$*" in
  *task_list*)
    # A test that needs specific tasks (with notes) points
    # DOSSIER_TEST_TASKS at a JSON file and gets it back verbatim. Real
    # `task_list` omits the `notes` key entirely on a task that has none
    # (`skip_serializing_if = "Vec::is_empty"`), so fixtures must be able to
    # exercise both shapes — a mock that always emits `notes` would hide the
    # exact ambiguity that caused a wrong reading of this API.
    if [[ -n "${DOSSIER_TEST_TASKS:-}" && -r "${DOSSIER_TEST_TASKS}" ]]; then
      cat "${DOSSIER_TEST_TASKS}"
      exit 0
    fi
    # Real dossier task_list returns `project` as the project id (prj_…)
    # and `project_slug` as the slug. Mirror that shape so hook regressions
    # that revert to reading `.project` are caught by the existing
    # "--project prj_" guard in the bats suite.
    cat <<'EOF'
[
  {
    "id": "tsk_TEST01",
    "project": "prj_FIXTURE01HOOK1FIXTURE01HK",
    "project_slug": "mcp-workstation",
    "slug": "gh-pr-merge-hook",
    "title": "gh pr merge hook",
    "status": "in_progress"
  },
  {
    "id": "tsk_CREATE01",
    "project": "prj_FIXTURE02HOOK2FIXTURE02HK",
    "project_slug": "mcp-workstation",
    "slug": "gh-pr-create-hook",
    "title": "gh pr create hook",
    "status": "in_progress"
  }
]
EOF
    ;;
  *task_update*)
    # Real dossier task_update appends a note and echoes the updated task. Only
    # the exit code reaches a hook, so record the call the same way the other
    # write verbs are recorded and stay silent.
    _record_call task_update "$*"
    ;;
  *task_complete*)
    _record_call task_complete "$*"
    ;;
  *artifact_link*)
    _record_call artifact_link "$*"
    ;;
  *artifact_list*)
    # The merge hook resolves a receipt's verdict FK by listing verdicts and
    # matching meta.head_sha. Return one verdict row whose head_sha matches the
    # success-with-verdict fixture's --match-head-commit; the hook's jq filter
    # drops it for any other head sha (non-matching merges get no FK).
    if [[ "$*" == *"--kind verdict"* ]]; then
      cat <<'EOF'
[
  {
    "id": "art_VERDICT01",
    "project": "prj_FIXTURE01HOOK1FIXTURE01HK",
    "kind": "verdict",
    "ref": "gate://mcp-workstation/pr/42/run_x",
    "meta": {
      "source": "gate",
      "outcome": "pass",
      "pr": "42",
      "head_sha": "cafebabecafebabecafebabecafebabecafebabe",
      "grant": "grt_x",
      "tier": "T1"
    }
  }
]
EOF
    else
      printf '[]\n'
    fi
    ;;
  *)
    echo "unexpected dossier invocation: $*" >&2
    exit 1
    ;;
esac
